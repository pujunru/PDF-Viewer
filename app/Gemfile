source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
#
# The floor is 1.16, not the template's 1.13: React Native's codegen writes
# rncore into node_modules during pod install, and 1.15.x does not produce it
# for this workspace layout, so the Fabric podspec's guard fails the build with
# "Codegen did not run properly".
gem 'cocoapods', '>= 1.16'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
# The template pinned xcodeproj < 1.26.0, which is what dragged resolution back
# down to CocoaPods 1.15.x: 1.16+ requires xcodeproj >= 1.26. Left unpinned so
# it can satisfy whichever CocoaPods is chosen.
gem 'xcodeproj'
