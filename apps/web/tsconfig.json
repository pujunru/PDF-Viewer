{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      // react-native-web ships no type declarations of its own; it implements
      // the react-native API surface, so the shared components typecheck
      // against RN's types on both platforms.
      "react-native": ["../../node_modules/react-native/types"],
      "@pdf-viewer/*": ["../../packages/*/src"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/*/src"],
  // PdfViewport.native.tsx is the macOS half of the platform split; it imports
  // react-native-webview, which is not a dependency of the web app.
  "exclude": ["../../packages/*/src/*.native.tsx"]
}
