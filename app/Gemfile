source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
#
# The lower bound is 1.16 rather than 1.13: React Native's codegen writes
# rncore into node_modules during pod install, and 1.15.x resolves this
# workspace's paths differently, so the generated directory never appears and
# the Fabric podspec's guard fails the build with "Codegen did not run
# properly". Without this floor an unpinned CI resolved 1.15.2 and broke.
gem 'cocoapods', '>= 1.16', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
